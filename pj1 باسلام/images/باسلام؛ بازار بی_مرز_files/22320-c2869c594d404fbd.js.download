این مزایا استفاده کنم؟",answer:"هیچ محدودیتی نداری. تا زمانی که اشتراکت فعاله، می‌تونی نامحدود از غرفه‌های پرو خرید کنی و از تخفیف‌ها لذت ببری."},{question:"اشتراک زودکس‌پلاس و کدهای تخفیف چیه؟",answer:"با خرید اشتراک سلام‌پرو، عضو «زودکس‌پلاس» هم می‌شی (۵ تا ۲۰٪ تخفیف + ۲۵,۰۰۰ تومان تخفیف ارسال غذا). علاوه بر این، در طول دوره اشتراکت، باسلام کدهای تخفیف ویژه‌ای بهت می‌ده که می‌تونی ازشون استفاده کنی و بیشتر سود کنی."},{question:"قوانین لغو، تمدید یا انتقال اشتراک چطوره؟",answer:"اشتراک سلام‌پرو روی شماره موبایلت فعال می‌شه و امکان انتقال به شماره دیگه یا لغو و بازگشت وجه رو نداره. اما هر زمان که اشتراکت تمام شد، می‌تونی خیلی راحت با خرید اشتراک جدید، اون رو تمدید کنی."},{question:"آیا روی سفارش‌های «پس‌کرایه» هم تخفیف ارسال می‌گیرم؟",answer:"تو سفارش‌های پس‌کرایه (چون هزینه ارسال رو موقع تحویل مستقیماً به مأمور پرداخت می‌کنی)، تخفیف ارسال سلام‌پرو روی فاکتورت اعمال نمی‌شه؛ اما خیالت راحت باشه، تخفیف‌های خود محصولات هنوزم سرجاشه و کامل حساب می‌شه."}]},o=function(n){var e=n.minimumBasketToman,r=n.shippingDiscountToman;return[{title:"خرید از غرفه پرو، به‌صرفه‌تر",condition:"حداقل سفارش پرو: ".concat(e," تومان"),icon:"/public-229/admin/67gZL/08-02/elDM5N9wVbXiywOomlw8lDXKCQTKLac3IUFZCWXTr5j6zwU6SG.SVG",items:["تا ۱۵٪ تخفیف محصول در هر سفارش","".concat(r," تومان تخفیف هزینه ارسال"),"نامحدود در تعداد دفعات استفاده"]},{title:"اشتراک زودکس‌پلاس",condition:"فعال فقط در شهرهای تحت پوشش",items:["تا 20٪ تخفیف + 25,000 تومان تخفیف ارسال","فعال در مدت اشتراک پرو"],icon:"/public-229/admin/67gZL/08-02/ztU3lvU4HOy5nSdB6Nf12RCbNLBtsY1QqCNX0f2v3qWEZHLuMV.SVG",description:"<b>شهرهای فعال:</b> کرمان، مشهد، شیراز، قشم، قم، زرند بندرعباس، کیش، رفسنجان، سیرجان، بم، جیرفت، ماهان، بافت"},{title:"کد تخفیف اختصاصی",condition:"حداقل سفارش هر کد: 500,000 تومان",icon:"/public-229/admin/67gZL/08-02/iobEHNipWtZ2KiS5Hc2MpkNTkAYdcJYYcv6ghvjA2KxEixuptK.SVG",items:["1 کد 80,000 تومانی در اشتراک 30 روزه","2 کد 80,000 تومانی در اشتراک 90 روزه","قابل استفاده در همه غرفه‌ها"]}]},u=function(n){var e=n.ship