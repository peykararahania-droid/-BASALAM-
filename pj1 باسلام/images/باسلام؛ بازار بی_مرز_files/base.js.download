    sku: "",
    category: "",
    price: "span.yVL64g",
    discounted: "span.OYeCuj",
    },
];
var pathIsValidForProduct = false;
if (pSelectors[0]) {
pathIsValidForProduct = checkPath(pSelectors[0].pattern_type, pSelectors[0].pattern);
if (pSelectors[0].params) {
params = getParameterByName(pSelectors[0].params);
if (params)
adx_url.searchParams.append(pSelectors[0].params, params);
}
}
var adx_os = getOs();
function main_function(tag_id, adexouid) {
let product = '';
if (pathIsValidForProduct) {
product = encodeURIComponent(getProduct());
}
let xhr = new XMLHttpRequest();
xhr.open("GET", domain + "/retargeting/push?tag=" + String(tag_id) + "&uid=" + String(adexouid)+ "&os=" + adx_os
+ "&feed=30"+"&url="+adx_url.toString()+"&p="+product);
xhr.withCredentials = 1;
xhr.send(null);
}
