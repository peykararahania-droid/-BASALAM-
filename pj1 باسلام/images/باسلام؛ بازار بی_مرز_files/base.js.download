var adx_url = new URL(location.href.split("?")[0].split("#")[0]);
function isPrefix(mainString, prefix) {
return (mainString.substring(0, prefix.length) === prefix)
}
function isPostfix(mainString, postfix) {
return (mainString.substring(mainString.length - postfix.length, mainString.length) === postfix)
}
function checkPath(type, pattern) {
url = adx_url.toString();
switch (type) {
case "^":
if (isPrefix(url, pattern)) {
return true;
}
case "%":
if (url.includes(pattern)) {
return true;
}
case "-":
if (isPostfix(url, pattern)) {
return true;
}
case "=":
if (url === pattern) {
return true;
}
}
return false;
}
var pSelectors = [
    {
    cid: 24,
    type: "continual",
