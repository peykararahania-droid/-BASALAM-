)return v;}}return null;}function amountForAny(texts,labels){for(var i=0;i<labels.length;i++){var v=amountForLabel(texts,labels[i]);if(v!=null)return v;}return null;}function send(transactionId,revenue,extras,legacyExtras){if(typeof yektanet==="undefined")return false;if(typeof yektanet.checkout==="function"){yektanet.checkout(TAG,{transaction_id:transactionId,revenue:revenue,extras:extras});return true;}if(typeof yektanet.event==="function"){yektanet.event(TAG,legacyExtras);return true;}return false;}function capture(){var texts=leafTexts();var gross=amountForLabel(texts,"قیمت محصولات");var disc=amountForLabel(texts,"تخفیف محصولات");var fee=amountForAny(texts,["هزینه خدمات","هزینه بازارداری"]);var shipping=amountForAny(texts,["مجموع هزینه ارسال","هزینه ارسال"]);var payable=amountForAny(texts,["مبلغ قابل پرداخت","قابل پرداخت","مبلغ پرداختی"]);if(!plausible(shipping))return false;var value=null;if(plausible(payable))value=payable-shipping;else if(plausible(gross))value=gross-(disc||0)+(fee||0);if(!plausible(value))value=null;var rec={shipping:shipping};try{var prev=JSON.parse(localStorage.getItem(STORE)||"null");if(value!=null)rec.value=value;else if(prev&&plausible(prev.value))rec.value=prev.value;localStorage.setItem(STORE,JSON.stringify(rec));}catch(e){}return true;}function readStored(){try{var o=JSON.parse(localStorage.getItem(STORE)||"null");if(o&&plausible(o.shipping))return o;}catch(e){}return null;}function readPurchase(){var dl=window.dataLayer||[];for(var i=dl.length-1;i>=0;i--){var e=dl[i];if(e&&e.event==="f_purchase"&&e.f_data){var f=e.f_data;var payable=Math.round(Number(f.value)/10);var merch=null;if(f.items&&f.items.length){var sum=0;for(var j=0;j<f.items.length;j++){var it=f.items[j]||{};sum+=(Number(it.price)||0)*(Number(it.quantity)||1);}merch=Math.round(sum/10);}return{invoice_id:String(f.invoice_id||""),payable:payable,merchandise:merch};}}return null;}function urlInvoice(){if(!includes(location.href,"success"))return "";var inv=location.href.split("invoiceId=")[1];if(!inv)return "";return inv.split("&")[0];}function sendData(requireValue){try{if(!includes(location.href,"success"))return false;var fp=readPurchase();var invoice_id=(fp&&fp.invoice_id)||urlInvoice();if(!invoice_id)return false;var value=null;var shipping=null;var stored=readStored();if(fp&&plausible(fp.payable))if(stored){shipping=stored.shipping;value=fp.payable-shipping;}else if(plausible(fp.merchandise)){value=fp.merchandise;shipping=fp.payable-fp.merchandise;}else value=fp.payable;else if(stored&&plausible(stored.value)){value=stored.value;shipping=stored.shipping;}if(!plausible(value))value=null;if(requireValue&&value==null)return false;if(alreadySent(invoice_id))return true;var extra_data={invoice_id:invoice_id};var legacy_data={invoice_id:invoice_id};if(value!=null){extra_data.shipping=plausible(shipping)?shipping:0;legacy_data.value=value;legacy_data.shipping=extra_data.shipping;}var revenue=value;if(value!=null&&plausible(shipping))revenue=value+shipping;if(!send(invoice_id,revenue,extra_data,legacy_data))return false;markSent(invoice_id);try{localStorage.removeItem(STORE);}catch(e){}return true;}catch(e){return false;}}if(includes(location.href,"/cart/payment/result")){if(sendData(true))return;var retry=0;var intervalId=setInterval(function(){if(sendData(true))clearInterval(intervalId);else if(retry++>15){clearInterval(intervalId);sendData(false);}},1000);}else if(includes(location.href,"/cart/payment")){capture();var cretry=0;var cid=setInterval(function(){capture();if(cretry++>8)clearInterval(cid);},1000);}})();}}, "title": "invoice id 2", "type": "goal", "patterns": [{"type": "R", "query": "\\/cart\\/payment\\/result.*success.*", "params": {}, "referrer_domain": ""}], "default": false, "account_id": "vWIg3kXD", "account_type": "adv", "advertiser_id": 2523}, {"id": "7d6164db-3b0f-4fc2-b052-26aa12e32099", "event": {"type": "G", "trigger_mode": "once-per-session", "categories": ["\u0622\u0631\u0627\u06cc\u0634\u06cc \u0648 \u0628\u06